#!/usr/bin/env bash
# Git pre-push hook: Automatically increment firmware version, commit, tag, and push.

set -e

# Prevent recursive execution during automated push
if [ "$GIT_BUMP_IN_PROGRESS" = "1" ]; then
    exit 0
fi

# Do not run if rebasing or merging
if [ -d "$(git rev-parse --git-dir)/rebase-merge" ] || [ -d "$(git rev-parse --git-dir)/rebase-apply" ]; then
    exit 0
fi

has_branch_push=0
current_remote_ref=""

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletion
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    case "$local_ref" in
        refs/heads/*)
            has_branch_push=1
            current_remote_ref="$remote_ref"
            ;;
    esac
done

if [ "$has_branch_push" -eq 0 ]; then
    exit 0
fi

# If the latest commit was already an automated version bump, allow it through without bumping again
last_commit_msg=$(git log -1 --pretty=%s)
if [[ "$last_commit_msg" =~ ^chore(\(release\))?:\ bump\ version ]]; then
    exit 0
fi

echo "========================================================"
echo "[pre-push] Automated version bump triggered..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON_BIN="$(which python3 || which python)"

if [ -z "$PYTHON_BIN" ]; then
    echo "[pre-push] Warning: python3 not found, skipping version bump."
    exit 0
fi

BUMP_OUTPUT=$("$PYTHON_BIN" "$REPO_ROOT/scripts/bump_version.py")
echo "$BUMP_OUTPUT"

NEW_VERSION=$(echo "$BUMP_OUTPUT" | grep -oE "NEW_VERSION=[^ ]+" | cut -d= -f2)
NEW_TAG=$(echo "$BUMP_OUTPUT" | grep -oE "NEW_TAG=[^ ]+" | cut -d= -f2)

if [ -z "$NEW_VERSION" ]; then
    echo "[pre-push] Failed to parse new version, aborting push."
    exit 1
fi

# Commit only the version files
git add "$REPO_ROOT/main/apps/common/common.h"
if [ -f "$REPO_ROOT/main/apps/common/audio/common.h" ]; then
    git add "$REPO_ROOT/main/apps/common/audio/common.h"
fi

git commit -m "chore: bump version to $NEW_VERSION" --no-verify

# Create git tag for the release
if [ -n "$NEW_TAG" ]; then
    git tag -d "$NEW_TAG" 2>/dev/null || true
    git tag -a "$NEW_TAG" -m "Release $NEW_TAG"
    echo "[pre-push] Tagged $NEW_TAG"
fi

REMOTE_NAME="$1"
if [ -z "$REMOTE_NAME" ]; then
    REMOTE_NAME="origin"
fi

echo "[pre-push] Pushing new commit and tag ($NEW_TAG) to $REMOTE_NAME..."
export GIT_BUMP_IN_PROGRESS=1
git push "$REMOTE_NAME" HEAD:"$current_remote_ref" "$NEW_TAG" --no-verify

echo "========================================================"
echo "[pre-push] Successfully bumped and pushed $NEW_VERSION ($NEW_TAG)!"
echo "========================================================"

# Exit with non-zero to cancel the original pre-bump push process
exit 1
